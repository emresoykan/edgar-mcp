# SEC Fair Access: zorunlu. Format: isim + e-posta
# https://www.sec.gov/os/webmaster-faq#code-support
EDGAR_USER_AGENT=Your Name your.email@example.com

# Railway: http (PORT varken boş bırakmak da http yapar). Lokal Cursor: stdio
MCP_TRANSPORT=http

# Claude custom connector çoğu planda Authorization header gönderemez.
# Token koyup MCP_AUTH_REQUIRED=true yaparsan Claude "Authentication failed" der.
# Claude Code header gönderebiliyorsa:
# MCP_AUTH_TOKEN=
# MCP_AUTH_REQUIRED=true
